<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>Repertum</AssemblyName>
    <RootNamespace>Repertum</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>repertum.ico</ApplicationIcon>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Version>1.2.0</Version>
    <Product>Repertum</Product>
    <Title>Repertum</Title>
    <Description>Copia e hash di chiavette USB in sola lettura</Description>
    <Copyright>Copyright (c) 2026 Daniele Lo Re</Copyright>
    <Company>Daniele Lo Re</Company>
    <Authors>Daniele Lo Re</Authors>
    <RepositoryUrl>https://github.com/erold90/repertum</RepositoryUrl>
    <DebugType>none</DebugType>
    <GenerateResourceUsePreserializedResources>false</GenerateResourceUsePreserializedResources>
  </PropertyGroup>
  <ItemGroup>
    <!-- il Core entra come sorgente, non come DLL: Repertum.exe resta un file unico -->
    <Compile Include="..\Repertum.Core\**\*.cs" Exclude="..\Repertum.Core\bin\**;..\Repertum.Core\obj\**" Link="Core\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Management" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <Import Project="..\Repertum.Core\Versione.targets" />
</Project>
