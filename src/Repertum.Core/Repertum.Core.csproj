<Project Sdk="Microsoft.NET.Sdk">
  <!-- Il Core si compila qui in net48 e net8.0 con C# 7.3: e' la prova che resta portabile.
       Repertum.Windows ne include i sorgenti (un solo .exe); Repertum.Desktop lo usa come progetto. -->
  <PropertyGroup>
    <TargetFrameworks>net48;net8.0</TargetFrameworks>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Repertum.Core</AssemblyName>
    <RootNamespace>Repertum</RootNamespace>
    <Version>1.2.0</Version>
    <DebugType>none</DebugType>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <Import Project="Versione.targets" />
</Project>
